// ============================================================
// ZENQOR TECHNOLOGIES - firestore.rules (SECURE v3.8)
// ============================================================
// PERUBAHAN v3.1:
//   - getUserRole() kini baca dokumen guna UID (request.auth.uid)
//     yang konsisten dengan cara app.js menyimpan data pengguna.
//   - Pengguna hanya boleh kemas kini status presence rekod pekerja sendiri.
//   - Staff/Management mesti menggunakan domain syarikat yang diluluskan;
//     Client menggunakan e-mel yang didaftarkan oleh staff.
//   - Sokong migrasi UID automatik melalui pending_access semasa login.
//   - Benarkan penyelarasan identiti claim berdasarkan Employee ID kekal.
//   - Sokong Payment Voucher dengan pencipta yang boleh diaudit.
//   - Hadkan bacaan koleksi pekerja dan pelanggan mengikut role/pemilik.
// ============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function hasApprovedCompanyEmail(email) {
      return email is string && (
        email.matches('^[^@]+@zenq0r[.]com$') ||
        email.matches('^[^@]+@zenqor[.]com[.]my$')
      );
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isApprovedStaffSession() {
      return isAuthenticated() &&
        request.auth.token.email is string &&
        hasApprovedCompanyEmail(request.auth.token.email);
    }

    // Baca role dari dokumen users/{uid} — UID sebagai doc ID
    function getUserRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserRecord().role;
    }

    // Staff Portal LOCK. Superadmin/Director may lock a portal account: the
    // record and its role stay exactly as they are, but the account holds no
    // role for the length of the lock, so every rule below that asks "is this
    // an HR/Account/IT/Staff/Client/admin session?" answers no. Reads of one's
    // OWN users/{uid} document deliberately stay open (see that match block) so
    // the portal can tell the person their access is locked instead of
    // mislabelling the denial as a removed account. `accessLocked` is absent on
    // every record predating this feature, hence the field-existence guard.
    // Both of these take the already-fetched record rather than fetching it
    // again. The first version of isAccessLocked() called getUserRecord() twice
    // in one expression, and hasActiveRole() then called it a third time through
    // getUserRole() — so every role question cost three reads where the original
    // getUserRole() cost one. A Client feels that worst: Client is checked last
    // in every role list, so it pays for each failed check ahead of it.
    function recordIsLocked(record) {
      return 'accessLocked' in record && record.accessLocked == true;
    }

    function recordHasActiveRole(record, role) {
      return record.role == role && !recordIsLocked(record);
    }

    function isAccessLocked() {
      return recordIsLocked(getUserRecord());
    }

    function hasActiveRole(role) {
      return recordHasActiveRole(getUserRecord(), role);
    }

    // Superadmin, Director and Finance hold the company's money and its people's
    // records, so none of those roles counts until the emailed sign-in code has
    // been confirmed for THIS sign-in. /api/verify-login-otp writes the
    // sign-in's auth_time into the sfa claim when the code is right; a later
    // password sign-in carries a new auth_time, so a stamp left over from an
    // earlier one no longer matches. A stolen password used straight against
    // the SDK therefore opens nothing these roles can reach. The account's own
    // users/{uid} record is not role-gated and stays readable, which is how the
    // portal learns it has to ask for the code at all.
    function secondFactorCleared() {
      return request.auth.token.get('sfa', 0) == request.auth.token.auth_time;
    }

    function isSuperadmin() {
      return isApprovedStaffSession() && secondFactorCleared() && hasActiveRole('Superadmin');
    }

    function isDirector() {
      return isApprovedStaffSession() && secondFactorCleared() && hasActiveRole('Director');
    }

    function isAdmin() {
      return isSuperadmin() || isDirector();
    }

    function isHR() {
      return isApprovedStaffSession() && hasActiveRole('HR');
    }

    function isAccount() {
      return isApprovedStaffSession() && secondFactorCleared() && hasActiveRole('Account');
    }

    function isIT() {
      return isApprovedStaffSession() && hasActiveRole('IT');
    }

    function isStaff() {
      return isApprovedStaffSession() && hasActiveRole('Staff');
    }

    function isClient() {
      return isAuthenticated() && hasActiveRole('Client');
    }

    // Superadmin, Director, HR and Account — the finance/personnel roles
    // that together gate payroll, billing, employee and claims records
    // throughout this file. Equivalent to
    // isFinanceOrHR() (isAdmin() is
    // isSuperadmin() || isDirector(), so this also covers every
    // isFinanceOrHR() chain in this file), but fetches
    // the caller's users/{uid} record once instead of once per role — the
    // rules engine's 1,000-expression-per-request budget is shared across
    // every branch of an `allow` condition, charged whether or not that
    // branch ends up being the one that matches, and this exact 4-role
    // combination used to be the busiest repeated check in the file
    // (claims/payment_vouchers' multi-branch update rules hit that budget
    // on some denied writes before this consolidation).
    function isFinanceOrHR() {
      let record = getUserRecord();
      return isApprovedStaffSession() && !recordIsLocked(record) && (
        record.role == 'HR' ||
        ((record.role == 'Superadmin' || record.role == 'Director' || record.role == 'Account') && secondFactorCleared())
      );
    }

    // Superadmin or Director, with HR added — the narrower admin+HR pairing
    // used for corrections and duty-roster management. Same single-fetch
    // shape as isFinanceOrHR() above; equivalent to isAdminOrHR().
    function isAdminOrHR() {
      let record = getUserRecord();
      return isApprovedStaffSession() && !recordIsLocked(record) && (
        record.role == 'HR' ||
        ((record.role == 'Superadmin' || record.role == 'Director') && secondFactorCleared())
      );
    }
    // Client tier gate. The tiers, and which features each opens, are defined in
    // app.js (CLIENT_TIER_ORDER / CLIENT_TIER_FEATURES); this mirrors the one
    // boundary that has to hold server-side -- replying is Premium and above.
    // Takes the already-fetched customer document so a caller pays for one read.
    // Case-insensitive on purpose: app.js normalizeOfficialRecord() uppercases
    // clientTier on write, so records on file read 'PREMIUM'/'PRIORITY' while
    // the form offers title case. Comparing exact case matched neither and
    // denied every client, including Priority ones.
    function tierAllowsReply(customer) {
      return customer.clientTier is string && (
        customer.clientTier.upper() == 'PREMIUM' ||
        customer.clientTier.upper() == 'PRIORITY'
      );
    }
    // Fails closed: a client whose directory record is missing cannot reply.
    // Their clientDirectoryId claim is what links them to a project at all, so
    // an absent record already means the account is not properly provisioned.
    function callerTierAllowsReply() {
      return request.auth.token.clientDirectoryId is string &&
        exists(/databases/$(database)/documents/customers/$(request.auth.token.clientDirectoryId)) &&
        tierAllowsReply(get(/databases/$(database)/documents/customers/$(request.auth.token.clientDirectoryId)).data);
    }

    function isProjectManager() {
      return isAdmin();
    }

    // Any staff role (never Client) may CREATE a project — every creation is
    // still audited client-side (logAudit). This is deliberately narrower in
    // scope than isProjectManager(), which stays the read/update/delete
    // authority over EXISTING projects everywhere else in this file; only the
    // projects/{projectId} create rule and project_ref_counters below read
    // this function.
    function canCreateProject() {
      return isFinanceOrHR() || isIT() || isStaff();
    }

    // The project's PIC, or a staff member with an activity on it: exactly the
    // two staff grants of the projects read rule.
    function staffWorksOnProject(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return project.get('ownerEmail', '') == request.auth.token.email ||
        project.get('activityAssigneeEmails', []).hasAny([request.auth.token.email]);
    }

    function isDocumentProjectPic(data) {
      return isApprovedStaffSession() &&
        data.billingPicEmail is string &&
        data.billingPicEmail == request.auth.token.email &&
        data.type == 'Invoice' &&
        data.status != 'Draft';
    }

    // deliveryStatus (not status, the payment state) governs whether a client
    // may read an invoice at all — see sendInvoiceToClient(),
    // app/methods/billing.js, the only place it ever becomes 'Sent'. A record
    // with no deliveryStatus field is one saved before this field existed:
    // treated as already delivered UNLESS it is still literally a Draft,
    // which stayed hidden under the old status-only rule too — a legacy
    // Draft must not become newly readable just because it predates this
    // field, the same way a legacy Paid/Unpaid invoice must not become newly
    // HIDDEN by it.
    function clientCanReadInvoice(data) {
      return data.type != 'Invoice' ||
        data.deliveryStatus == 'Sent' ||
        (!('deliveryStatus' in data) && data.status != 'Draft');
    }

    // IT is trusted with the public zenqor-tech website's content collections
    // (Portfolio galleries, Services, page-text overrides) alongside Superadmin/
    // Director, but NOT with the rest of what isAdmin() unlocks (payroll, HR,
    // audit logs, user role management) — keep this scoped to those collections
    // only, never used as a stand-in for isAdmin() elsewhere.
    function isContentAdmin() {
      return isAdmin() || isIT();
    }

    function hasValidProjectStage(data) {
      return data.status in [
        'Project Planning',
        'Pending Documentation',
        'In Progress',
        'Pending By Government',
        'Completed & Done'
      ];
    }

    function hasValidProjectLinks(data) {
      return data.clientDirectoryId is string &&
        data.clientDirectoryId.size() > 0 &&
        data.clientPortalUid is string &&
        data.clientPortalUid.size() > 0 &&
        data.ownerEmpNo is string &&
        data.ownerEmpNo.size() > 0 &&
        data.clientName is string &&
        data.clientName.size() > 0 &&
        data.clientEmail is string &&
        data.clientEmail.size() > 0 &&
        data.ownerName is string &&
        data.ownerName.size() > 0 &&
        data.ownerEmail is string &&
        data.ownerEmail.size() > 0;
    }

    // Client Task is the required parent of every project. getAfter() permits
    // the portal to create a missing parent customer task and its first project
    // in one atomic batch, while rejecting a standalone project without one.
    function hasClientTaskParent(clientDirectoryId) {
      return exists(/databases/$(database)/documents/customers/$(clientDirectoryId)) &&
        'clientTaskCreatedAt' in getAfter(/databases/$(database)/documents/customers/$(clientDirectoryId)).data &&
        getAfter(/databases/$(database)/documents/customers/$(clientDirectoryId)).data.clientTaskCreatedAt is string &&
        getAfter(/databases/$(database)/documents/customers/$(clientDirectoryId)).data.clientTaskCreatedAt.size() > 0;
    }

    // The company domains are for staff and management, and for nobody else. A
    // Client is by definition somebody outside the company, so their sign-in
    // address must NOT be on an approved company domain — the mirror image of
    // the rule that has always applied to staff. Client access used to be
    // domain-neutral here, which allowed a company address to be provisioned as
    // an external customer's login.
    function hasAllowedRoleEmail(data) {
      return data.email is string && (
        (data.role == 'Client' && !hasApprovedCompanyEmail(data.email)) ||
        (data.role != 'Client' && hasApprovedCompanyEmail(data.email))
      );
    }

    // Multi-user Client Portal access: a customers/{clientDirectoryId} record's
    // primary clientEmail is always an owner; additionalClientEmails (optional
    // array, may not exist on older records) lets staff authorize extra people
    // from the same client company (e.g. their finance contact) without giving
    // them a separate customer record. Guards field existence first since
    // Firestore Rules errors — rather than false — on `x in <missing field>`.
    function customerEmailMatches(customerData, email) {
      return customerData.clientEmail == email || (
        'additionalClientEmails' in customerData &&
        customerData.additionalClientEmails is list &&
        email in customerData.additionalClientEmails
      );
    }

    function hasMatchingPendingAccess() {
      return isAuthenticated() &&
        request.auth.token.email is string &&
        exists(/databases/$(database)/documents/pending_access/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/pending_access/$(request.auth.token.email)).data.email == request.auth.token.email;
    }

    // ---- Money -------------------------------------------------------------
    //
    // SST, EPF, SOCSO and EIS are all worked out in the browser, and a browser
    // is not a place anything can be enforced: devtools can change a figure
    // between the form and the save. None of the rules below decide what a
    // price or a salary *should* be — that is a commercial decision this file
    // has no business in — they decide that the figures which are DERIVED
    // agree with the inputs they claim to come from. A tampered SST rate, a
    // payslip whose EPF is not 11% of its own wages, or a grand total that is
    // not its own subtotal minus its own discount, are all refused here no
    // matter which role sends them or what the interface displayed.
    //
    // Everything is compared in whole cents. The rules engine and the browser
    // both work in doubles, so comparing ringgit directly would eventually
    // fail on a value neither of them got wrong; one cent of tolerance absorbs
    // that without leaving room for a meaningful forgery.

    function figure(data, key) {
      return data.get(key, 0) is number ? data.get(key, 0) : 0;
    }

    function cents(value) {
      return math.round(value * 100);
    }

    function centsMatch(left, right) {
      return math.abs(left - right) <= 1;
    }

    // ---- Quotations and invoices ----
    // SST is 8%. The grand total is subtotal - discount + SST. A discount
    // cannot exceed what is being discounted, and nothing may be negative.
    function billingTotalsConsistent(data) {
      return centsMatch(cents(figure(data, 'sst')), cents(figure(data, 'subtotal') * 0.08)) &&
        centsMatch(
          cents(figure(data, 'amount')),
          cents(figure(data, 'subtotal') - figure(data, 'discount') + figure(data, 'sst'))
        ) &&
        figure(data, 'subtotal') >= 0 &&
        figure(data, 'discount') >= 0 &&
        figure(data, 'discount') <= figure(data, 'subtotal');
    }

    // Documents saved before the totals were broken out carry no `subtotal`.
    // They stay readable and their workflow keeps moving — a status change, a
    // payment proof, a PIC handover — but the moment a figure on one of them
    // moves, it has to come back as a consistent set.
    function billingTotalsAccepted() {
      return 'subtotal' in request.resource.data
        ? billingTotalsConsistent(request.resource.data)
        : request.resource.data.amount == resource.data.amount;
    }

    // ---- Payslips ----
    // Contributions are checked against the published schedules — EPF Third
    // Schedule Parts A and E, PERKESO Act 4 (with LINDUNG 24 Jam from June 2026)
    // and EIS Act 800 — not against their headline percentages, which differ
    // from what is actually remitted on most salaries. app/constants/statutory.js
    // holds the tables in full; the rules engine evaluates at most 1,000
    // expressions per request, so here the first six bands are listed and every
    // later band is worked out the way those tables are (tests/rules/
    // payroll.rules.test.js writes a payslip in every band to prove they agree).
    //
    // EPF is charged on the fixed wage and bonus; SOCSO and EIS add overtime.
    function payslipEpfWages(raw) {
      return figure(raw, 'basic') + figure(raw, 'phone') + figure(raw, 'transport') +
        figure(raw, 'meal') + figure(raw, 'bonus');
    }

    function payslipDeductions(raw) {
      return figure(raw, 'dedEpf') + figure(raw, 'dedSocso') + figure(raw, 'dedSkbbk') + figure(raw, 'dedEis') +
        figure(raw, 'dedPcb') + figure(raw, 'dedAdvance') + figure(raw, 'dedOther');
    }

    function wagesInSen(value) {
      return math.round(value * 100.0);
    }

    // EPF bands run RM20 wide to RM5,000 and RM100 wide to RM20,000; a share is
    // the rate on the band's upper limit, rounded up to the next ringgit. Above
    // RM20,000 it is the rate on the wages themselves.
    function epfBandUpperInSen(sen) {
      return sen <= 500000 ? math.ceil(sen / 2000.0) * 2000 : (sen <= 2000000 ? math.ceil(sen / 10000.0) * 10000 : sen);
    }

    // Part A: 11%. Part E (60 and above): nothing from the employee.
    function epfEmployeeSen(epfSen, senior) {
      return (senior || epfSen <= 1000) ? 0 : math.ceil(epfBandUpperInSen(epfSen) * 11 / 10000.0) * 100;
    }

    // PERKESO and EIS bands: to RM30, 50, 70, 100, 140, 200 (0-5), then RM100
    // wide to RM6,000 (6-63); above RM6,000 contributes as RM6,000 does.
    function perkesoBand(sen) {
      return sen <= 3000 ? 0 : (sen <= 5000 ? 1 : (sen <= 7000 ? 2 : (sen <= 10000 ? 3 : (sen <= 14000 ? 4 :
        (sen <= 20000 ? 5 : (sen > 590000 ? 63 : 5 + math.ceil((sen - 20000) / 10000.0)))))));
    }

    // From band 6 the tables charge each rate on the band's midpoint, in ringgit.
    function perkesoMidpoint(band) {
      return 250 + 100 * (band - 6);
    }

    // Act 4, employee, Invalidity Scheme (0.5%). Nothing from 60.
    function socsoInvaliditySen(band) {
      return band < 6 ? [10, 20, 30, 40, 60, 85][band] : perkesoMidpoint(band) / 2;
    }

    // Act 4, employee, Non-Employment Injury Scheme — LINDUNG 24 Jam, first
    // phase 0.75% — which PERKESO rounds down to ten sen and adds five.
    function skbbkSen(band) {
      return band < 6 ? [20, 30, 50, 65, 90, 125][band] : math.floor(perkesoMidpoint(band) * 75 / 1000.0) * 10 + 5;
    }

    // Act 800, employee (0.2%). Nothing from 60.
    function eisSen(band) {
      return band < 6 ? [5, 10, 15, 20, 25, 35][band] : perkesoMidpoint(band) / 5;
    }

    // LINDUNG 24 Jam: from the 2026-06 contribution month to 2028-05 (the
    // published first phase), no age limit, not for an employee who opted out.
    function skbbkApplies(raw, month) {
      return raw.get('skbbkOptedOut', false) != true && month >= '2026-06' && month <= '2028-05';
    }

    function payslipScheduleAgrees(raw, epfSen, grossSen) {
      let senior = raw.get('isSenior', false) == true;
      let month = raw.get('month', '') is string ? raw.get('month', '') : '';
      let band = perkesoBand(grossSen);
      return month <= '2028-05' &&
        centsMatch(wagesInSen(figure(raw, 'dedEpf')), epfEmployeeSen(epfSen, senior)) &&
        centsMatch(wagesInSen(figure(raw, 'dedSocso')), (senior || grossSen <= 0) ? 0 : socsoInvaliditySen(band)) &&
        centsMatch(wagesInSen(figure(raw, 'dedSkbbk')), (grossSen > 0 && skbbkApplies(raw, month)) ? skbbkSen(band) : 0) &&
        centsMatch(wagesInSen(figure(raw, 'dedEis')), (senior || grossSen <= 0) ? 0 : eisSen(band));
    }

    // Figures entered by hand — a voluntary higher EPF rate, a foreign worker,
    // a month whose table is not published here yet — carry the reason, which
    // the portal also writes to the audit log.
    function payslipManualContributionsRecorded(raw) {
      return raw.get('statutoryOverrideReason', '') is string &&
        raw.get('statutoryOverrideReason', '').size() >= 5 &&
        figure(raw, 'dedEpf') >= 0 && figure(raw, 'dedSocso') >= 0 &&
        figure(raw, 'dedSkbbk') >= 0 && figure(raw, 'dedEis') >= 0;
    }

    // Net pay is deliberately NOT required to be positive. It is already pinned
    // to gross minus its own deductions, and a month where a repayment or an
    // advance swallows the salary is a real thing a payroll has to record.
    function payslipFiguresConsistent(data) {
      let raw = data.raw;
      let epfWages = payslipEpfWages(raw);
      let gross = epfWages + figure(raw, 'ot');
      return (raw.get('statutoryOverride', false) == true
          ? payslipManualContributionsRecorded(raw)
          : payslipScheduleAgrees(raw, wagesInSen(epfWages), wagesInSen(gross))) &&
        centsMatch(cents(figure(data, 'amount')), cents(gross - payslipDeductions(raw))) &&
        figure(raw, 'basic') >= 0;
    }

    // Same easing as billing: a payslip filed before this rule existed keeps
    // its metadata editable, but its money cannot move without being right.
    function payslipFiguresAccepted() {
      return payslipFiguresConsistent(request.resource.data) ||
        (resource != null && request.resource.data.amount == resource.data.amount);
    }

    // An approver decides yes or no and passes the record on. Everything else
    // about a claim or voucher — its amount, what it was for, whose it is —
    // belongs to the person who filed it, and nobody approving it may change
    // any of that in the same write. These are the only fields a decision
    // moves: HR and Finance forward or reject, and the full-access pair also
    // records the final approval and its supporting document.
    function claimForwardKeys() {
      return [
        'status', 'assignedToUid', 'assignedToName', 'assignedToEmail', 'assignedToRole', 'approvalHistory',
        'rejectedByUid', 'rejectedByName', 'rejectedByRole', 'rejectedAt'
      ];
    }

    function claimFinalDecisionKeys() {
      return [
        'status', 'assignedToUid', 'assignedToName', 'assignedToEmail', 'assignedToRole', 'approvalHistory',
        'rejectedByUid', 'rejectedByName', 'rejectedByRole', 'rejectedAt',
        'finalDecision', 'settlementStatus', 'statusDetail', 'approvalPath', 'approvalPreviousStatus', 'bypassedReviews',
        'approvedByUid', 'approvedByName', 'approvedByEmail', 'approvedByRole', 'approvedAt',
        'directorApprovalAttachment', 'directorApprovalAttachmentName', 'directorApprovalOriginalBytes'
      ];
    }

    // A rejection or an approval names whoever made it, never whoever the
    // payload claims made it. Takes the write's affectedKeys() (see
    // canUpdateClaimOrVoucher() below) instead of computing its own
    // diff() — every caller already has one to share.
    function isClaimDecision(affected, fromStatuses, toStatuses, allowedKeys) {
      return resource.data.status in fromStatuses &&
        request.resource.data.status in toStatuses &&
        affected.hasOnly(allowedKeys) &&
        (request.resource.data.status != 'Rejected' || request.resource.data.rejectedByUid == request.auth.uid) &&
        (request.resource.data.status != 'Approved' || request.resource.data.approvedByUid == request.auth.uid);
    }

    // An employee who files and follows their own claims, vouchers and
    // payslips rather than everybody's: the Staff role, and IT, who are
    // employees too but whose module list has no Claims screen of its own.
    function isSelfServiceEmployee() {
      return isStaff() || isIT();
    }

    // Superadmin and Director may correct any claim or payment voucher, at any
    // stage — including its amount. What keeps that from undoing the rule
    // above is that a correction is a write of its own: the status cannot move
    // in it, so a figure is never changed inside the same write that approves
    // it, and the edit is stamped with who made it (the portal also records it
    // in the audit log). Approval and correction stay two separate acts, each
    // with its own trail.
    // `admin` is the caller's isAdmin() result, already computed once by
    // canUpdateClaimOrVoucher() below — see the note there.
    function isAdminClaimCorrection(admin, affected) {
      return admin &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.lastEditedByUid == request.auth.uid &&
        affected.hasOnly([
          'type', 'documentType', 'date', 'expenseDate', 'name', 'position', 'dept',
          'empNo', 'empEmail', 'payeeName', 'payeeType', 'payeeReference', 'paymentPurpose',
          'category', 'subCategory', 'amount', 'receiptNo', 'description',
          'receiptAttachment', 'receiptAttachmentName', 'receiptAttachmentOriginalBytes',
          'lastEditedByUid', 'lastEditedByName', 'lastEditedAt'
        ]);
    }

    // Shared by claims/{claimId} and payment_vouchers/{voucherId} below: both
    // collections ran this identical 7-branch decision as two literal
    // copies before this consolidation — only selfEditableKeys differs
    // (payment_vouchers edits paymentDate/voucherNo where claims edits
    // expenseDate/receiptNo).
    //
    // Two things are computed ONCE here and threaded through every branch,
    // instead of being recomputed inside isHR()/isAccount()/isAdmin()/
    // isAdminClaimCorrection()/isClaimDecision() calls scattered across the
    // 7 branches: `affected` (request.resource.data's diff against
    // resource.data — a full document diff is not cheap) and the caller's
    // users/{uid} record (each of isHR()/isAccount()/isAdmin() used to
    // fetch it independently, so a compound check like
    // isAdmin() || isHR() || isAccount() cost 3 fetches). hr/account/admin
    // below reproduce isHR()/isAccount()/isAdmin() exactly (same
    // isApprovedStaffSession(), secondFactorCleared() and lock semantics),
    // just against one shared fetch. Combined, this and the branch
    // reordering below are what closed the "maximum of 1,000 expressions"
    // failures some denied writes to this rule used to hit.
    //
    // Branches are ordered by how often they actually fire, not by how the
    // workflow reads top-to-bottom: every claim/voucher passes through the
    // three-stage decision (HR forward, Account forward, Director/
    // Superadmin final) at least once per stage over its life, so those go
    // first — an admin correction or an HR identity sync is rare, and now
    // only gets evaluated once the common cases have already failed to
    // match. `||` has no side effects between branches, so reordering
    // changes nothing about which writes are allowed, only how much work a
    // typical one costs to check.
    function canUpdateClaimOrVoucher(affected, selfEditableKeys) {
      let record = getUserRecord();
      let staffSession = isApprovedStaffSession();
      let unlocked = !recordIsLocked(record);
      let sfa = secondFactorCleared();
      let hr = staffSession && unlocked && record.role == 'HR';
      let account = staffSession && unlocked && sfa && record.role == 'Account';
      let admin = staffSession && unlocked && sfa && (record.role == 'Superadmin' || record.role == 'Director');
      let financeOrHr = hr || account || admin;
      return (
        hr && isClaimDecision(affected, ['Pending HR'], ['Pending Account', 'Rejected'], claimForwardKeys())
      ) || (
        account && isClaimDecision(affected, ['Pending Account'], ['Pending Director', 'Rejected'], claimForwardKeys())
      ) || (
        // Superadmin approves alongside Director: the client gate lets them,
        // and without this the write is refused after the UI has said yes.
        admin && isClaimDecision(affected, ['Pending HR', 'Pending Account', 'Pending Director'], ['Approved', 'Rejected'], claimFinalDecisionKeys())
      ) || (
        isAuthenticated() &&
        resource.data.status == 'Pending HR' &&
        request.resource.data.status == 'Pending HR' &&
        request.resource.data.empNo == resource.data.empNo &&
        ((isSelfServiceEmployee() && resource.data.empEmail == request.auth.token.email) ||
          (financeOrHr && 'createdByUid' in resource.data && resource.data.createdByUid == request.auth.uid)) &&
        affected.hasOnly(selfEditableKeys)
      ) || isAdminClaimCorrection(admin, affected) || (
        (hr || admin) && affected.hasOnly(['name', 'position', 'dept', 'empEmail'])
      ) || (
        admin &&
        resource.data.status == 'Approved' &&
        request.resource.data.status == 'Approved' &&
        affected.hasOnly([
          'documentType', 'type', 'finalDecision', 'settlementStatus', 'statusDetail',
          'assignedToUid', 'assignedToName', 'assignedToEmail', 'assignedToRole',
          'approvalPath'
        ])
      );
    }

    // clockInAt/clockOutAt MUST be the serverTimestamp() sentinel: Firestore
    // Rules resolve it to request.time before this function ever sees it, so
    // a forged client-side Date can never land in either field — the one
    // deviation in this app from every other feature's plain ISO-string
    // timestamp, because this is the one field a spoofed device clock could
    // otherwise falsify.
    function isSelfAttendanceRecord(data) {
      return data.empEmail is string && data.empEmail == request.auth.token.email;
    }

    // HR/Admin correcting a mistaken clock event — same shape as
    // isAdminClaimCorrection() above: stamped with who corrected it, and
    // scoped to exactly the fields a correction may touch. HR is included
    // here (unlike isAdminClaimCorrection, Admin-only) because attendance
    // corrections are routine HR work, not a financial-record override.
    function isAttendanceCorrection() {
      return (isAdminOrHR()) &&
        request.resource.data.empNo == resource.data.empNo &&
        request.resource.data.lastEditedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clockInAt', 'clockOutAt', 'status',
          'lastEditedByUid', 'lastEditedByName', 'lastEditedAt', 'correctionNote'
        ]);
    }

    // The company profile is the letterhead: clients read it on the support
    // page, staff print it onto quotations and invoices. Every signed-in
    // session may read that one document; the rest of this collection, such
    // as audit_retention, stays with Admin and IT, who alone may write here.
    match /settings/{docId} {
      allow read: if (isAuthenticated() && docId == 'company_profile') || isAdmin() || isIT();
      allow write: if isAdmin() || isIT();
    }

    match /users/{userId} {
      // Staff require the internal directory for assignments and workflow routing.
      // Clients may read only their own portal profile; project records already contain
      // the public PIC fields needed by the Client workspace.
      // Own record: any signed-in account, on its own document only. This was
      // isClient()-scoped, which now resolves to false for a locked account —
      // and a locked account that cannot read its own record gets a denial the
      // portal can only report as "your access was removed". Reading the one
      // document that says why you are locked is not a privilege worth
      // withholding, so it is granted on identity rather than on role.
      allow read: if isApprovedStaffSession() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if (
        request.auth.uid == userId &&
        hasMatchingPendingAccess() &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == get(/databases/$(database)/documents/pending_access/$(request.auth.token.email)).data.role
      ) || (isAdmin() && hasAllowedRoleEmail(request.resource.data));
      allow delete: if isAdmin();
      allow update: if (isAdmin() && hasAllowedRoleEmail(request.resource.data)) || (
        request.auth.uid == userId &&
        // A locked account may still READ this record (that is how it learns it
        // is locked) but may not keep writing to it — presence pings included,
        // which would otherwise show a locked account as online in the roster.
        !isAccessLocked() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo', 'mustChangePassword', 'updatedAt', 'themePreference', 'lastSeenChangelogVersion', 'notificationsLog', 'presenceStatus', 'isOnline', 'presenceUpdatedAt', 'lastSeen']) &&
        // Every staff account can read this record, so the notification history
        // lives in private/notifications instead. The old field may only be
        // taken off a record as it moves there, never written back onto one.
        !('notificationsLog' in request.resource.data && request.resource.data.diff(resource.data).affectedKeys().hasAny(['notificationsLog']))
      ) || (
        // HR can correct a name typo/legal-name change via the HR Employees form
        // (syncEmployeeIdentityReferences), which needs to keep this portal login
        // record's display name in step with the employees/{empNo} record HR
        // actually edits. Scoped to exactly that one field — role and email
        // stay untouchable here.
        isHR() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
      );

      // What only the account itself should see: the toasts it has been shown,
      // which name records, amounts and deletions. The users/{uid} record above
      // is read by every staff session for the directory, so this cannot live
      // on it.
      match /private/{docId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId && docId == 'notifications';
      }
    }

    // Why an account was locked. The lock itself stays on users/{uid}, where
    // the rules read it; the reason an administrator typed is kept here, for
    // the administrators and the locked person, not for the whole directory.
    // Written only by /api/portal-account through the Admin SDK.
    match /access_locks/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow write: if false;
    }

    match /pending_access/{email} {
      allow read: if isAdmin() || (
        isAuthenticated() && request.auth.token.email == email
      );
      allow create, update: if isAdmin() &&
        request.resource.data.email == email &&
        hasAllowedRoleEmail(request.resource.data);
      allow delete: if isAdmin() || (
        isAuthenticated() && request.auth.token.email == email
      );
    }

    // Staff Portal ACCESS REQUESTS — the queue behind the Accept/Reject buttons.
    // A staff member raises one for themselves from their own Profile page and
    // Superadmin/Director decide it. Three things this deliberately refuses:
    // raising a request in somebody else's name, raising one that asks for the
    // Client role (a Client login belongs to a customer record, not to an
    // internal request), and the requester touching the row afterwards — a
    // request that can be rewritten after it is filed decides nothing.
    match /access_requests/{requestId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.requesterUid == request.auth.uid
      );
      allow create: if isApprovedStaffSession() &&
        !isAccessLocked() &&
        request.resource.data.requesterUid == request.auth.uid &&
        request.resource.data.requesterEmail == request.auth.token.email &&
        request.resource.data.currentRole == getUserRole() &&
        request.resource.data.requestedRole != 'Client' &&
        request.resource.data.status == 'Pending';
      // Deciding is the only update, and it may never rewrite who asked for
      // what — only how it was answered.
      allow update: if isAdmin() &&
        request.resource.data.requesterUid == resource.data.requesterUid &&
        request.resource.data.requesterEmail == resource.data.requesterEmail &&
        request.resource.data.requestedRole == resource.data.requestedRole &&
        request.resource.data.status in ['Accepted', 'Rejected'];
      allow delete: if isAdmin();
    }

    match /employees/{empId} {
      allow read: if isFinanceOrHR() || (
        (isStaff() || isIT()) && resource.data.email == request.auth.token.email
      );
      allow create: if isAdminOrHR();
      allow delete: if isAdmin();
      // National ID/Passport, Bank Account and EPF/SOCSO may be set once at create
      // (HR's isHR() clause above still applies there), but on an UPDATE to an
      // already-existing employee record those four fields must stay byte-identical
      // unless the caller is Superadmin/Director — HR can still update everything
      // else on the record freely. Mirrors the client's "leave blank = unchanged"
      // save behavior (saveEmployee() in app.js reverts a blanked sensitive field
      // to its original value before writing), so a legitimate no-change save from
      // HR never trips this.
      allow update: if isAdmin() || (
        isHR() &&
        request.resource.data.ic == resource.data.ic &&
        request.resource.data.bankAcc == resource.data.bankAcc &&
        request.resource.data.epfNo == resource.data.epfNo &&
        request.resource.data.socsoNo == resource.data.socsoNo
      ) || (
        isAuthenticated() &&
        resource.data.email is string &&
        request.auth.token.email is string &&
        resource.data.email == request.auth.token.email &&
        request.resource.data.presenceUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'presenceStatus', 'isOnline', 'presenceUid', 'presenceUpdatedAt', 'lastSeen'
        ])
      );
    }

    match /customers/{customerId} {
      allow read: if isFinanceOrHR() || (
        isClient() && customerEmailMatches(resource.data, request.auth.token.email)
      );
      allow create, update: if isFinanceOrHR();
      allow delete: if isAdmin();
    }

    match /docs/{docId} {
      allow read: if isAuthenticated() && (
        isFinanceOrHR() || isIT() ||
        // A PIC may read only sent invoices indexed to that PIC. Drafts,
        // quotations and another project's billing data stay unavailable.
        isDocumentProjectPic(resource.data) ||
        // An invoice draft or one merely prepared-but-not-yet-sent belongs to
        // the Finance workspace until Send Invoice to Client is actually
        // pressed — see clientCanReadInvoice() above.
        (isClient() && clientCanReadInvoice(resource.data) && resource.data.raw.clientEmail == request.auth.token.email) ||
        (
          // Multi-user Client Portal: a secondary authorized email (see
          // customers/{id}.additionalClientEmails) doesn't match raw.clientEmail
          // (always the primary contact's), so fall back to the linked customer
          // record the same way client_documents does.
          isClient() &&
          clientCanReadInvoice(resource.data) &&
          resource.data.raw.customerId is string &&
          resource.data.raw.customerId.size() > 0 &&
          customerEmailMatches(get(/databases/$(database)/documents/customers/$(resource.data.raw.customerId)).data, request.auth.token.email)
        )
      );
      allow create: if (isFinanceOrHR()) &&
        billingTotalsConsistent(request.resource.data);
      allow update: if ((isFinanceOrHR()) && billingTotalsAccepted()) || (
        // A client records their own decision on their own open quotation, and
        // nothing else. Ownership is established the same two ways the read
        // rule above allows: the primary contact, or an authorized secondary
        // email on the linked customer record.
        isClient() &&
        resource.data.type == 'Quotation' &&
        resource.data.status == 'Open' &&
        request.resource.data.status in ['Accepted', 'Rejected'] &&
        (
          resource.data.raw.clientEmail == request.auth.token.email || (
            resource.data.raw.customerId is string &&
            resource.data.raw.customerId.size() > 0 &&
            customerEmailMatches(get(/databases/$(database)/documents/customers/$(resource.data.raw.customerId)).data, request.auth.token.email)
          )
        ) &&
        // The decision is stamped as whoever is signed in, never as whoever the
        // payload claims. Without this a client could accept their own quotation
        // and attribute it to someone else, which is the whole point of the stamp.
        request.resource.data.clientDecisionByUid == request.auth.uid &&
        // Every figure stays exactly as issued — only the decision and its
        // stamp may move.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'clientDecisionAt', 'clientDecisionByUid', 'clientDecisionByName', 'clientDecisionNote'
        ])
      ) || (
        // A client attaches proof of payment to their own unpaid invoice.
        // status is absent from hasOnly, so submitting proof can never mark an
        // invoice Paid — only staff decide that, after looking at the proof.
        isClient() &&
        resource.data.type == 'Invoice' &&
        resource.data.status != 'Paid' &&
        (
          resource.data.raw.clientEmail == request.auth.token.email || (
            resource.data.raw.customerId is string &&
            resource.data.raw.customerId.size() > 0 &&
            customerEmailMatches(get(/databases/$(database)/documents/customers/$(resource.data.raw.customerId)).data, request.auth.token.email)
          )
        ) &&
        request.resource.data.paymentProofByUid == request.auth.uid &&
        // paymentRefNo and the clientPayment* fields are the client's own claim
        // about the transfer they made — which bank, whose account, when and how
        // much — typed alongside the proof in the same submission, not something
        // staff set in advance (see submitPaymentProof(), app/methods/client-workflow.js).
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentProofUrl', 'paymentProofName', 'paymentProofAt', 'paymentProofByUid', 'paymentProofByName', 'paymentRefNo',
          'clientPaymentBank', 'clientPaymentAccountType', 'clientPaymentAccountHolder', 'clientPaymentDate', 'clientPaymentAmount'
        ])
      );
      // Finance is the Account role. It may remove only official billing
      // documents; every other document delete remains Director/Superadmin.
      allow delete: if isAdmin() || (isAccount() && resource.data.type in ['Invoice', 'Quotation']);
    }

    // Idempotency/audit markers for the trusted /api/billing-workflow endpoint.
    // The Admin SDK alone writes these; browser sessions cannot forge a workflow
    // handover or suppress a notification by creating its marker first.
    match /billing_events/{eventId} {
      allow read, write: if false;
    }

    // Client Document Repository — centralized JPEG/JPG/PNG/PDF storage metadata per client.
    // Actual file bytes live in Firebase Storage (see storage.rules); this collection only
    // tracks who uploaded what, when, and the Storage path/download URL.
    match /client_documents/{documentId} {
      allow read: if isAuthenticated() && (
        isFinanceOrHR() || isIT() ||
        (isClient() && customerEmailMatches(get(/databases/$(database)/documents/customers/$(resource.data.clientDirectoryId)).data, request.auth.token.email))
      );
      allow create: if isAuthenticated() &&
        request.resource.data.clientDirectoryId is string &&
        request.resource.data.clientDirectoryId.size() > 0 &&
        (
          isFinanceOrHR() ||
          (isClient() &&
            customerEmailMatches(get(/databases/$(database)/documents/customers/$(request.resource.data.clientDirectoryId)).data, request.auth.token.email))
        ) &&
        request.resource.data.uploadedByUid == request.auth.uid &&
        request.resource.data.uploadedByEmail == request.auth.token.email &&
        request.resource.data.storagePath is string &&
        request.resource.data.storagePath.size() > 0 &&
        request.resource.data.storagePath == 'client_documents/' + request.resource.data.clientDirectoryId + '/' + request.resource.data.storageFileName &&
        request.resource.data.fileName is string &&
        request.resource.data.fileName.size() > 0 &&
        request.resource.data.fileType in ['image/jpeg', 'image/png', 'application/pdf'] &&
        request.resource.data.fileSize is number &&
        request.resource.data.fileSize > 0 &&
        request.resource.data.fileSize <= 10485760;
      allow update: if false;
      allow delete: if isFinanceOrHR();
    }

    // Password reset tokens for the custom (non-Firebase-hosted) reset flow — written and
    // read exclusively by the /api/*.js serverless functions via the Admin SDK, which
    // bypasses these rules entirely. No client, staff or otherwise, should ever touch this
    // collection directly.
    match /password_reset_tokens/{token} {
      allow read, write: if false;
    }

    // Email OTP confirming a password reset — handled exclusively by
    // api/request-login-otp.js, api/verify-login-otp.js and
    // api/confirm-password-reset.js via the Admin SDK, which bypasses these
    // rules entirely. Same deny-all pattern as password reset.
    match /password_reset_otp_codes/{fingerprint} {
      allow read, write: if false;
    }

    // "Trust this device" — lets a sign-in skip the emailed code for 30 days.
    // Only /api/verify-login-otp (Admin SDK) may mint or renew one, after
    // independently re-verifying who is signing in; a user may list and
    // delete (revoke) only their own, which is all the Settings > Trusted
    // Devices screen needs. Never updatable — a compromised token cannot be
    // extended or re-pointed at a different device, only replaced by a fresh
    // sign-in through the normal code challenge.
    match /trusted_devices/{deviceId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create, update: if false;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Per-account API abuse counters are maintained only by server-side Admin SDK code.
    match /security_rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /payslips/{payslipId} {
      allow read: if isAuthenticated() && (
        isFinanceOrHR() ||
        (isSelfServiceEmployee() && resource.data.raw.empEmail == request.auth.token.email)
      );
      allow create: if (isFinanceOrHR()) &&
        payslipFiguresConsistent(request.resource.data);
      allow update: if (isFinanceOrHR()) &&
        payslipFiguresAccepted();
      allow delete: if isAdmin();
    }

    match /claims/{claimId} {
      allow read: if isAuthenticated() && (
        isFinanceOrHR() ||
        (isSelfServiceEmployee() && resource.data.empEmail == request.auth.token.email)
      );
      allow create: if isAuthenticated() &&
        request.resource.data.createdByUid == request.auth.uid && (
          (isSelfServiceEmployee() && request.resource.data.empEmail == request.auth.token.email) ||
          isFinanceOrHR()
        );
      allow update: if canUpdateClaimOrVoucher(
        request.resource.data.diff(resource.data).affectedKeys(),
        [
          'type', 'documentType', 'date', 'expenseDate', 'name', 'position', 'dept',
          'payeeName', 'payeeType', 'payeeReference', 'paymentPurpose', 'category',
          'subCategory', 'amount', 'receiptNo', 'description', 'receiptAttachment',
          'receiptAttachmentName', 'receiptAttachmentOriginalBytes', 'createdByUid',
          'createdByEmail', 'createdAt'
        ]
      );
      allow delete: if isAdmin();
    }

    // Payment Vouchers — dedicated collection, independent from Claims (same approval workflow/roles).
    match /payment_vouchers/{voucherId} {
      allow read: if isAuthenticated() && (
        isFinanceOrHR() ||
        (isSelfServiceEmployee() && resource.data.empEmail == request.auth.token.email)
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.createdByUid == request.auth.uid && (
          (isSelfServiceEmployee() && request.resource.data.empEmail == request.auth.token.email) ||
          isHR() || isAccount()
        ))
      );
      allow update: if canUpdateClaimOrVoucher(
        request.resource.data.diff(resource.data).affectedKeys(),
        [
          'type', 'documentType', 'date', 'paymentDate', 'name', 'position', 'dept',
          'payeeName', 'payeeType', 'payeeReference', 'paymentPurpose', 'category',
          'subCategory', 'amount', 'voucherNo', 'description', 'receiptAttachment',
          'receiptAttachmentName', 'receiptAttachmentOriginalBytes', 'createdByUid',
          'createdByEmail', 'createdAt'
        ]
      );
      allow delete: if isAdmin();
    }

    // Attendance — self-service clock in/out, one document per employee per
    // calendar day (doc id = `${empNo}_${date}`), which also doubles as the
    // double-clock-in guard: a second create at the same derived id fails
    // outright, no query needed.
    match /attendance/{attendanceId} {
      allow read: if isFinanceOrHR() || (
        isApprovedStaffSession() && isSelfAttendanceRecord(resource.data)
      );
      allow create: if isApprovedStaffSession() &&
        attendanceId == request.resource.data.empNo + '_' + request.resource.data.date &&
        request.resource.data.empEmail == request.auth.token.email &&
        // empEmail alone is not enough — nothing above stops a signed-in staff
        // member from putting a colleague's empNo in the payload while keeping
        // their own email. This confirms the claimed empNo actually belongs to
        // the signed-in email, the same way claims/vouchers trust empNo only
        // after it is tied to an employee record elsewhere in this file.
        get(/databases/$(database)/documents/employees/$(request.resource.data.empNo)).data.email == request.auth.token.email &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.clockInAt == request.time &&
        request.resource.data.clockOutAt == null &&
        request.resource.data.status == 'Clocked In';
      allow update: if isAttendanceCorrection() || (
        isApprovedStaffSession() &&
        isSelfAttendanceRecord(resource.data) &&
        resource.data.status == 'Clocked In' &&
        request.resource.data.status == 'Clocked Out' &&
        request.resource.data.clockOutAt == request.time &&
        // Self clock-out is same-shift only: within 20 hours of the clock-in
        // this same rule already forced to be request.time. Without this, a
        // staff member could "clock out" a record left open for days,
        // stamping today's time onto it and fabricating a multi-day shift —
        // the app's own UI never offers this (myTodayAttendanceRecord() only
        // looks at today), but the rule must refuse it too, not just hide the
        // button. A stale record like that is exactly what HR's correction
        // path (isAttendanceCorrection() above) exists to close out instead.
        request.time < resource.data.clockInAt + duration.value(20, 'h') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clockOutAt', 'status'])
      );
      allow delete: if isAdmin();
    }

    // Duty Roster — one document per week (doc id = Monday's date). HR/Admin
    // build a Draft, which stays invisible to everyone else until Published.
    match /duty_roster/{weekId} {
      allow read: if isFinanceOrHR() || (
        isApprovedStaffSession() && resource.data.status == 'Published'
      );
      allow create, update: if (isAdminOrHR()) &&
        request.resource.data.weekStartDate == weekId &&
        request.resource.data.status in ['Draft', 'Published'];
      allow delete: if isAdmin();
    }

    // Leave Requests — single-stage approval (unlike claims' three): a staff
    // member files a request, HR decides, and Superadmin/Director may correct
    // or decide directly at any time. Account is deliberately not part of this
    // workflow — leave is not a financial record — so it reads only its own
    // requests, the same as Staff and IT.
    function isSelfLeaveRequest(data) {
      return data.empEmail is string && data.empEmail == request.auth.token.email;
    }

    function leaveDecisionKeys() {
      return ['status', 'approvedByUid', 'approvedByName', 'approvedByEmail', 'approvedByRole', 'approvedAt',
              'rejectedByUid', 'rejectedByName', 'rejectedByRole', 'rejectedAt'];
    }

    // Deliberately its own function rather than a call into isClaimDecision():
    // that helper is claims/payment_vouchers' three-stage pipeline specifically
    // (tests/module-actions.test.js and tests/money-enforcement.test.js both
    // count its call sites to hold that pipeline to exactly three transitions
    // each), and leave is a single-stage decision on an unrelated collection.
    // The body is intentionally the same shape — a decision moves status
    // between two allowed sets and touches only the decision's own fields.
    function isLeaveDecision(fromStatuses, toStatuses, allowedKeys) {
      return resource.data.status in fromStatuses &&
        request.resource.data.status in toStatuses &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys) &&
        (request.resource.data.status != 'Rejected' || request.resource.data.rejectedByUid == request.auth.uid) &&
        (request.resource.data.status != 'Approved' || request.resource.data.approvedByUid == request.auth.uid);
    }

    // Same shape as isAdminClaimCorrection() — stamped, and the status never
    // moves in the same write, so a correction is never mistaken for a decision.
    function isLeaveCorrection() {
      return isAdmin() &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.lastEditedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'leaveType', 'startDate', 'endDate', 'totalDays', 'reason', 'name', 'position', 'dept', 'empEmail',
          'lastEditedByUid', 'lastEditedByName', 'lastEditedAt'
        ]);
    }

    match /leave_requests/{leaveId} {
      allow read: if isAdminOrHR() || (
        isApprovedStaffSession() && isSelfLeaveRequest(resource.data)
      );
      allow create: if isApprovedStaffSession() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.empEmail == request.auth.token.email &&
        get(/databases/$(database)/documents/employees/$(request.resource.data.empNo)).data.email == request.auth.token.email &&
        request.resource.data.status == 'Pending HR';
      allow update: if isLeaveCorrection() || (
        isApprovedStaffSession() &&
        isSelfLeaveRequest(resource.data) &&
        resource.data.status == 'Pending HR' &&
        request.resource.data.status == 'Pending HR' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leaveType', 'startDate', 'endDate', 'totalDays', 'reason'])
      ) || (
        (isHR() || isAdmin()) && isLeaveDecision(['Pending HR'], ['Approved', 'Rejected'], leaveDecisionKeys())
      );
      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        // Director/Superadmin can supervise every process. Other internal
        // staff may only read projects where they are the assigned PIC.
        // This is intentionally paired with the ownerEmail query in app.js so
        // a crafted client request cannot retrieve another staff member's work.
        isProjectManager() || (
          isApprovedStaffSession() &&
          resource.data.ownerEmail is string &&
          resource.data.ownerEmail == request.auth.token.email
        ) || (
          resource.data.clientEmail is string &&
          resource.data.clientEmail == request.auth.token.email &&
          resource.data.clientPortalUid == request.auth.uid
        ) || (
          // A staff member assigned to at least one Project Activity in this
          // project also needs the project card itself (client, stage, PIC,
          // target date) to open its Project Activities view.
          // activityAssigneeEmails is a denormalized, non-sensitive access index
          // maintained by the PIC whenever an activity is created, reassigned or
          // deleted — a rule cannot query another collection, so the index has to
          // live on the project. It mirrors project_activities.projectOwnerEmail.
          isApprovedStaffSession() &&
          resource.data.get('activityAssigneeEmails', []).hasAny([request.auth.token.email])
        ) || (
          // Multi-user Client Portal: a secondary authorized email (see
          // customers/{id}.additionalClientEmails) shares the primary
          // contact's clientDirectoryId claim, so this covers them too
          // without needing a separate clientPortalUid on every project.
          isClient() && resource.data.clientDirectoryId == request.auth.token.clientDirectoryId
        )
      );
      allow create: if (isProjectManager() || canCreateProject()) &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdByEmail == request.auth.token.email &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.updatedByEmail == request.auth.token.email &&
        hasValidProjectLinks(request.resource.data) &&
        hasClientTaskParent(request.resource.data.clientDirectoryId) &&
        request.resource.data.projectRef is string &&
        request.resource.data.title is string &&
        request.resource.data.clientEmail is string &&
        hasValidProjectStage(request.resource.data);
      allow update: if (
        isProjectManager() &&
          request.resource.data.createdByUid == resource.data.createdByUid &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.projectRef == resource.data.projectRef &&
          request.resource.data.updatedByUid == request.auth.uid &&
          request.resource.data.updatedByEmail == request.auth.token.email &&
          request.resource.data.projectRef is string &&
          request.resource.data.title is string &&
          request.resource.data.clientEmail is string &&
          hasValidProjectLinks(request.resource.data) &&
          hasValidProjectStage(request.resource.data)
      ) || (
        isApprovedStaffSession() &&
          resource.data.ownerEmail == request.auth.token.email &&
          request.resource.data.updatedByUid == request.auth.uid &&
          request.resource.data.updatedByEmail == request.auth.token.email &&
          hasValidProjectStage(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'startDate', 'targetDate', 'description', 'updatedAt', 'updatedByUid', 'updatedByEmail',
            'completedAt', 'completedByUid', 'completedByEmail'
          ])
      ) || (
        (isAdminOrHR()) &&
          request.resource.data.ownerEmpNo == resource.data.ownerEmpNo &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerName', 'ownerEmail', 'ownerPosition', 'ownerDepartment'
          ])
      ) || (
        isApprovedStaffSession() &&
        resource.data.ownerEmail == request.auth.token.email &&
        request.resource.data.ownerEmpNo == resource.data.ownerEmpNo &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerPresenceStatus', 'ownerPresenceUpdatedAt', 'ownerLastSeen'
        ])
      ) || (
        isApprovedStaffSession() &&
        resource.data.ownerEmail == request.auth.token.email &&
        request.resource.data.ownerEmpNo == resource.data.ownerEmpNo &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerPhoto'])
      ) || (
        // Maintenance of the activity-assignee access index (see the read rule
        // above). Only the project's own PIC or a Project Manager may touch it,
        // and only that one key plus the audit timestamp may change — it can
        // never alter the project's stage, client or owner. This grants no
        // authority the PIC doesn't already hold by assigning the activity.
        (
          isProjectManager() || (
            isApprovedStaffSession() && resource.data.ownerEmail == request.auth.token.email
          )
        ) &&
        request.resource.data.activityAssigneeEmails is list &&
        request.resource.data.activityAssigneeEmails.size() <= 200 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activityAssigneeEmails', 'updatedAt'
        ])
      ) || (
        // Project handover: the CURRENT owner hands the project to a new PIC.
        // Only owner-identity + the handover trail may change — status, dates,
        // description and client info are untouched, so a handover can never
        // change the project's workflow stage. (Admin-triggered handover
        // already works via the unrestricted isProjectManager() branch above.)
        isApprovedStaffSession() &&
          resource.data.ownerEmail == request.auth.token.email &&
          request.resource.data.ownerEmpNo is string &&
          request.resource.data.ownerEmpNo != resource.data.ownerEmpNo &&
          request.resource.data.updatedByUid == request.auth.uid &&
          request.resource.data.updatedByEmail == request.auth.token.email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerEmpNo', 'ownerName', 'ownerEmail', 'ownerPhoto', 'ownerPosition',
            'ownerDepartment', 'ownerAssignedAt', 'ownerPresenceStatus',
            'ownerPresenceUpdatedAt', 'ownerLastSeen', 'handoverHistory',
            'updatedAt', 'updatedByUid', 'updatedByEmail'
          ])
      );
      allow delete: if isProjectManager();
    }

    // One document per Project Type per year (id "PREFIX_YEAR", e.g.
    // "DOC_2026"), holding only a running count — the source of every new
    // project's reference number (see generateProjectRef() in
    // app/methods/projects.js). Written inside a client-side Firestore
    // transaction so two staff members creating a project at the same moment
    // can never be handed the same reference, even though projects/{id} reads
    // are PIC-scoped and neither of them can see the other's project. count
    // may only move forward by exactly 1 per write — never jump, never reset.
    match /project_ref_counters/{counterId} {
      allow read: if canCreateProject() || isProjectManager();
      allow create: if (canCreateProject() || isProjectManager()) &&
        request.resource.data.count == 1;
      allow update: if (canCreateProject() || isProjectManager()) &&
        request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /project_activities/{activityId} {
      // Activity Type, Assigned To and all other activity details are private to
      // the project's current PIC (or a Project Manager), plus the one staff
      // member the activity is actually assigned to — an assignee has to be able
      // to read the work scheduled for them. Every other staff account still sees
      // only the project's Client Activity/Status History and cannot read these
      // documents through the browser or a crafted SDK request.
      allow read: if isProjectManager() || (
        isApprovedStaffSession() &&
        resource.data.projectOwnerEmail == request.auth.token.email
      ) || (
        isApprovedStaffSession() &&
        resource.data.assignedEmail == request.auth.token.email
      );
      allow create: if (
        isProjectManager() ||
        (isApprovedStaffSession() &&
          get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerEmail == request.auth.token.email)
      ) &&
        exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId)) &&
        request.resource.data.projectOwnerEmail == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerEmail &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.projectId is string &&
        request.resource.data.projectId.size() > 0 &&
        request.resource.data.activityType is string &&
        request.resource.data.activityType.size() > 0 &&
        request.resource.data.assignedEmpNo is string &&
        request.resource.data.assignedEmpNo.size() > 0 &&
        request.resource.data.assignedEmail is string &&
        request.resource.data.assignedEmail.size() > 0 &&
        request.resource.data.summary is string &&
        request.resource.data.summary.size() > 0 &&
        request.resource.data.dueDate is string &&
        request.resource.data.status == 'Scheduled';
      allow update: if (
        isProjectManager()
      ) || (
        isApprovedStaffSession() &&
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerEmail == request.auth.token.email &&
        request.resource.data.projectId == resource.data.projectId &&
        request.resource.data.projectOwnerEmail == resource.data.projectOwnerEmail &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activityType', 'summary', 'dueDate', 'assignedEmpNo', 'assignedName', 'assignedEmail', 'assignedPosition', 'details', 'updatedAt', 'updatedByUid', 'updatedByEmail'
        ])
      ) || (
        isApprovedStaffSession() &&
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerEmail == request.auth.token.email &&
        request.resource.data.projectOwnerEmail == resource.data.projectOwnerEmail &&
        request.resource.data.status == 'Done' &&
        request.resource.data.completedByUid == request.auth.uid &&
        request.resource.data.completedByEmail == request.auth.token.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'completedAt', 'completedByUid', 'completedByEmail'
        ])
      ) || (
        // The assignee closes out their own scheduled work — the dashboard's
        // "My Assigned Project Activities" card is built around exactly this.
        // hasOnly() pins the change to the four completion fields, so Activity
        // Type, Assigned To, the summary and both access indexes stay immutable:
        // an assignee can neither retarget an activity nor widen their own access
        // through it, and cannot reopen one either (status must become 'Done').
        isApprovedStaffSession() &&
        resource.data.assignedEmail == request.auth.token.email &&
        request.resource.data.status == 'Done' &&
        request.resource.data.completedByUid == request.auth.uid &&
        request.resource.data.completedByEmail == request.auth.token.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'completedAt', 'completedByUid', 'completedByEmail'
        ])
      ) || (
        // The outgoing PIC can refresh the safe owner-email index only when a
        // project handover is committed in the same batch. getAfter() prevents
        // a standalone activity write from granting access to another user.
        isApprovedStaffSession() &&
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerEmail == request.auth.token.email &&
        request.resource.data.projectOwnerEmail == getAfter(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerEmail &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'projectOwnerEmail'
        ])
      );
      allow delete: if isProjectManager();
    }

    match /project_client_updates/{updateId} {
      allow read: if isAuthenticated() && (
        isProjectManager() ||
        // Staff read a client's conversation when they work on that project —
        // its PIC, or someone with an activity on it — the same people who can
        // open the project itself. It used to be every staff session, which put
        // every client's messages in every employee's browser.
        (isApprovedStaffSession() && staffWorksOnProject(resource.data.projectId)) ||
        resource.data.clientPortalUid == request.auth.uid || (
          // Multi-user Client Portal: a secondary authorized email shares the
          // primary contact's clientDirectoryId claim (see projects rule above)
          // rather than the project's single clientPortalUid.
          'clientDirectoryId' in resource.data &&
          resource.data.clientDirectoryId == request.auth.token.clientDirectoryId
        ) || (
          // Older updates predate both uid and Client Directory linkage. Their
          // clientEmail is the authenticated primary client's email, so keep
          // this narrow compatibility path for the historic conversation feed.
          'clientEmail' in resource.data &&
          resource.data.clientEmail is string &&
          resource.data.clientEmail == request.auth.token.email
        )
      );
      allow create: if isAuthenticated() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.projectId is string &&
        request.resource.data.projectId.size() > 0 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId)) &&
        request.resource.data.clientDirectoryId == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.clientDirectoryId && (
          (
            isApprovedStaffSession() &&
            request.resource.data.senderRole != 'Client' &&
            (
              isProjectManager() ||
              get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerEmail == request.auth.token.email
            ) &&
            get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.clientPortalUid == request.resource.data.clientPortalUid
          ) || (
            // A secondary client contact's own uid never matches the project's
            // single clientPortalUid, so authorize by clientDirectoryId claim
            // instead (mirrors the projects read rule's secondary-contact path).
            isClient() &&
            callerTierAllowsReply() &&
            request.resource.data.senderRole == 'Client' &&
            request.resource.data.clientPortalUid == request.auth.uid &&
            get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.clientDirectoryId == request.auth.token.clientDirectoryId
          )
        );
      allow update: if isProjectManager() || (
        isApprovedStaffSession() &&
        resource.data.senderUid == request.auth.uid &&
        request.resource.data.senderUid == resource.data.senderUid &&
        request.resource.data.projectId == resource.data.projectId &&
        request.resource.data.clientPortalUid == resource.data.clientPortalUid &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updateType', 'updateDate', 'message', 'updatedAt', 'updatedByUid'
        ])
      ) || (
        isClient() &&
        resource.data.senderRole == 'Client' &&
        resource.data.senderUid == request.auth.uid &&
        request.resource.data.senderUid == resource.data.senderUid &&
        request.resource.data.projectId == resource.data.projectId &&
        request.resource.data.clientPortalUid == resource.data.clientPortalUid &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'message', 'updatedAt', 'updatedByUid'
        ])
      );
      allow delete: if isProjectManager() || (
        isClient() &&
        resource.data.senderRole == 'Client' &&
        resource.data.senderUid == request.auth.uid
      );
    }

    // Recipient-specific alerts created by the trusted /api/notify endpoint.
    // A signed-in user can only see and acknowledge their own alerts; browser
    // clients can never create, redirect, or delete notifications for others.
    match /portal_notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.recipientUid == resource.data.recipientUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'hiddenAt']);
      allow create, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin() || isIT();
      // Audit events are written only by /api/audit-log through the Admin SDK.
      // Client writes are denied so users cannot forge identity, IP, or device metadata.
      allow create, update, delete: if false;
    }

    // Closed monthly accounting packages, doc id = YYYY-MM. Written by the portal
    // when the first sign-in of a new month closes the one before it.
    match /monthly_archives/{period} {
      // isStaff() is the 'Staff' role specifically, not staff-in-general. Read is
      // the same set that has the Reports module in ROLE_ACCESS and that already
      // reads docs/payslips: Superadmin, Director, HR, Account.
      allow read: if isFinanceOrHR();
      // Only Superadmin/Director may close or re-close a period, mirroring
      // canCloseAccountingPeriod in app.js.
      allow create, update: if isAdmin();
      // A closed period is a financial record: it may be rebuilt, never removed.
      allow delete: if false;
    }

    // ============================================================
    // ZENQOR-TECH (public corporate website) — shares this SAME Firebase
    // project (zenqor-portal-a3b2d) as of the Firebase connection work.
    // zenqor-tech has NO login/registration of its own (removed — visitors
    // needing authenticated access are directed to zenqor-portal via the
    // "Portal" button). isAdmin() below (Superadmin/Director) is kept only
    // so zenqor-portal staff can manage the marketing site's public content
    // (portfolio, services, messages) directly via Firebase Console
    // — see zenqor-tech/firebase-config.js.
    // ============================================================

    // Public content collections — explicit list (not a wildcard) so a
    // future collection never becomes accidentally public-readable just
    // because its name matches a generic pattern.
    match /portfolio_web/{document=**} {
      allow read: if true;
      allow write, delete: if isContentAdmin();
    }
    match /portfolio_gaming/{document=**} {
      allow read: if true;
      allow write, delete: if isContentAdmin();
    }
    match /services/{document=**} {
      allow read: if true;
      allow write, delete: if isContentAdmin();
    }
    match /navigation/{document=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /config/{document=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /content/{document=**} {
      allow read: if true;
      allow write, delete: if isContentAdmin();
    }
    match /testimonials/{document=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Public CREATE-only submissions — visitors can send, only admins read.
    match /contact_messages/{document=**} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'company', 'subject', 'message', 'status', 'createdAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 200 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 200 &&
        request.resource.data.message is string && request.resource.data.message.size() <= 5000 &&
        request.resource.data.status == 'UNREAD' &&
        // phone/company/subject/createdAt are optional, but if present they must still be
        // bounded — otherwise an anonymous submitter could smuggle an oversized/wrong-typed
        // value into any of these allowlisted keys, since hasOnly() only restricts which
        // keys exist, not what they contain.
        (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 50)) &&
        (!('company' in request.resource.data) || (request.resource.data.company is string && request.resource.data.company.size() <= 200)) &&
        (!('subject' in request.resource.data) || (request.resource.data.subject is string && request.resource.data.subject.size() <= 200)) &&
        (!('createdAt' in request.resource.data) || request.resource.data.createdAt is string);
      allow read, update, delete: if isAdmin();
    }

    // Pageview analytics — anyone can log a visit, only admins read the log.
    match /analytics_events/{document=**} {
      allow create: if request.resource.data.keys().hasOnly(['page', 'referrer', 'lang', 'timestamp']) &&
        request.resource.data.page is string && request.resource.data.page.size() <= 300 &&
        (!('referrer' in request.resource.data) || (request.resource.data.referrer is string && request.resource.data.referrer.size() <= 500)) &&
        (!('lang' in request.resource.data) || (request.resource.data.lang is string && request.resource.data.lang.size() <= 10)) &&
        (!('timestamp' in request.resource.data) || request.resource.data.timestamp is string);
      allow read: if isAdmin();
    }
  }
}
