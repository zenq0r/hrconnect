# sandbox | production
BILLPLZ_ENV=sandbox

# Get these from the matching Billplz Sandbox or Production account.
BILLPLZ_SECRET_KEY=replace_me
BILLPLZ_X_SIGNATURE_KEY=replace_me
BILLPLZ_COLLECTION_ID=replace_me

# Checkout branding. Amount is entered directly on the checkout form.
PRODUCT_NAME="ZenTec Gateway"

# Canonical production URL used for Billplz callback + redirect.
APP_URL=https://zentec-gateway.zenqor.com.my

# Finance notification email.
FINANCE_NOTIFICATION_EMAIL=finance@zenqor.com.my
MAIL_FROM_NAME="ZenTec Gateway"
MAIL_FROM_EMAIL=finance@zenqor.com.my

# Gmail Workspace SMTP (recommended) or any SMTP service.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=finance@zenqor.com.my
SMTP_PASS=replace_with_gmail_app_password
