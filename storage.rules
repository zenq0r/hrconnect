// ============================================================
// ZENQOR PORTAL - storage.rules
// Client Document Repository — file bytes for client_documents/{clientDirectoryId}/{fileName}
// Metadata for these files is tracked in Firestore's client_documents collection (see firestore.rules).
//
// Role/ownership checks read directly from the Auth ID token's custom claims
// (request.auth.token.role / .clientDirectoryId) instead of calling
// firestore.get()/firestore.exists() cross-service — that cross-service lookup
// does not work in this Firebase project (confirmed by direct testing: even the
// simplest possible firestore.exists() check with a hardcoded path fails here).
// Claims are kept in sync by api/sync-user-claims.js, called after login and
// whenever an admin changes a user's role in Portal Access Management.
// ============================================================
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // The role from the token, counted only once the roles that must clear the
    // sign-in code have cleared it for this sign-in. Mirrors
    // secondFactorCleared() in firestore.rules: the sfa claim holds the
    // auth_time of the sign-in whose code was confirmed.
    function userRole() {
      return !(request.auth.token.role in ['Superadmin', 'Director', 'Account']) ||
        request.auth.token.get('sfa', 0) == request.auth.token.auth_time
        ? request.auth.token.role
        : '';
    }

    function isStaffDocumentManager() {
      return isSignedIn() && userRole() in ['Superadmin', 'Director', 'HR', 'Account'];
    }

    function isStaffReader() {
      return isSignedIn() && userRole() in ['Superadmin', 'Director', 'HR', 'Account', 'IT'];
    }

    function isOwningClient(clientDirectoryId) {
      return isSignedIn() && userRole() == 'Client' &&
        request.auth.token.clientDirectoryId == clientDirectoryId;
    }

    // Mirrors firestore.rules' isContentAdmin() — IT is trusted with the public
    // zenqor-tech website's Portfolio images alongside Superadmin/Director, but
    // not with client document management (isStaffDocumentManager above).
    function isContentAdmin() {
      return isSignedIn() && userRole() in ['Superadmin', 'Director', 'IT'];
    }

    match /client_documents/{clientDirectoryId}/{fileName} {
      allow read: if isStaffReader() || isOwningClient(clientDirectoryId);
      allow write: if (isStaffDocumentManager() || isOwningClient(clientDirectoryId)) &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType in ['image/jpeg', 'image/png', 'application/pdf'];
      allow delete: if isStaffDocumentManager();
    }

    // Receipts, payment proofs and approval documents attached to a claim, a
    // payment voucher or a billing document. These used to be written into the
    // Firestore record as base64, which put the bytes inside every read of that
    // record; they are files here instead.
    //
    // The path carries the uploader's uid, so "your own attachment" is decided
    // by the path rather than by a lookup. An approver has to be able to see
    // what they are approving, which is the whole point of the attachment, so
    // the staff readers are admitted to all of them — the same set that already
    // reads the claim itself in firestore.rules.
    match /receipts/{ownerUid}/{fileName} {
      allow read: if isStaffReader() || (isSignedIn() && request.auth.uid == ownerUid);
      // Only ever the portal's own re-encoded JPEG: it resizes and re-encodes
      // before upload, so anything else arriving here did not come from it.
      allow write: if isSignedIn() && request.auth.uid == ownerUid &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg';
      allow delete: if isStaffDocumentManager() || (isSignedIn() && request.auth.uid == ownerUid);
    }

    // Public zenqor-tech Portfolio gallery images (Digital Systems / Licensing &
    // Permits). Publicly readable — these are marketing images shown to anonymous
    // site visitors — but only content admins may upload/replace/remove them.
    match /website_content/{collectionName}/{fileName} {
      allow read: if true;
      // Mirrors the portal's own validators (validateWebsiteContentImage /
      // validateWebsiteContentVideo): images JPEG/PNG up to 8 MB, video MP4 up to
      // 40 MB. Video was previously rejected here despite the gallery uploader
      // offering it, so every MP4 an admin picked failed at the Storage boundary.
      allow write: if isContentAdmin() &&
        collectionName in ['portfolio_web', 'portfolio_gaming'] && (
          (request.resource.contentType in ['image/jpeg', 'image/png'] &&
            request.resource.size <= 8 * 1024 * 1024) ||
          (request.resource.contentType == 'video/mp4' &&
            request.resource.size <= 40 * 1024 * 1024)
        );
      allow delete: if isContentAdmin();
    }
  }
}
